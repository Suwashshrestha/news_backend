# ── PostgreSQL (local — news_express) ─────────────────────────────────────────
POSTGRES_USER=news_admin
POSTGRES_PASSWORD=NewsPortal@12345
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=news_express

# Or full URL (@ in password must be encoded as %40):
# DATABASE_URL=postgresql+asyncpg://news_admin:NewsPortal%4012345@localhost:5432/news_express

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── Media files (saved on disk) ───────────────────────────────────────────────
MEDIA_ROOT=media
